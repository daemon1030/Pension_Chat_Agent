# CLOVA Studio Embedding API
# 실제 키는 .env 또는 배포 환경의 환경변수에만 설정한다.
CLOVASTUDIO_API_KEY= api 키 여기다가 복붙하세요
CLOVASTUDIO_EMBEDDING_HOST=clovastudio.stream.ntruss.com

# PostgreSQL + pgvector 로컬 개발용 설정
POSTGRES_DB=pension_agent
POSTGRES_USER=pension_app
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5433
PENSION_DATABASE_DSN=postgresql://pension_app:change-me-for-local-development@127.0.0.1:5433/pension_agent

# Langfuse 실행 추적 (설정하지 않으면 기존처럼 로컬 JSONL 로그만 남긴다.)
# Langfuse 프로젝트 설정에서 발급받은 키를 넣는다.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
